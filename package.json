{
  "name": "@iobroker/ai-gui",
  "version": "0.0.3",
  "description": "ioBroker AI chat for the browser: client, agent hook, generic tools and panel shared by admin, javascript and vis-2",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioBroker/ai-gui.git"
  },
  "homepage": "https://github.com/ioBroker/ai-gui#readme",
  "bugs": {
    "url": "https://github.com/ioBroker/ai-gui/issues"
  },
  "keywords": [
    "ioBroker",
    "ai",
    "chat",
    "react"
  ],
  "author": {
    "name": "ioBroker",
    "email": "info@iobroker.net"
  },
  "license": "MIT",
  "scripts": {
    "prepublishOnly": "npm run build",
    "clean": "rimraf build",
    "build": "tsc -p tsconfig.json",
    "check-ts": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs src",
    "test": "vitest run",
    "prettier": "prettier -u -w src",
    "release": "release-script -y --noPush --no-update-lockfile",
    "release-patch": "release-script patch --yes --no-update-lockfile --publishAll",
    "release-minor": "release-script minor --yes --no-update-lockfile --publishAll",
    "release-major": "release-script major --yes --no-update-lockfile --publishAll",
    "update-packages": "npx -y npm-check-updates --upgrade",
    "npm": "npm i"
  },
  "dependencies": {
    "@iobroker/ai-core": "^0.0.4"
  },
  "peerDependencies": {
    "@iobroker/gui-components": "^10.3.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/gui-components": "^10.3.9",
    "@iobroker/types": "^7.2.5",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "files": [
    "LICENSE",
    "README.md",
    "build"
  ]
}
