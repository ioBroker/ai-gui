{
    "compilerOptions": {
        "module": "esnext",
        "target": "es2022",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "noEmit": false,
        "declaration": true,
        "outDir": "./build",
        "sourceMap": true,
        "rootDir": "./src",
        "strict": true,
        "skipLibCheck": true,
        "lib": ["es2022", "DOM"],
        "jsx": "react",
        "types": ["@iobroker/types"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["src/**/*.test.ts"]
}
